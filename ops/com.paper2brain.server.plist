<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the web server (and its iCloud inbox polling) running after login. REPO is replaced on install; see README. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.paper2brain.server</string>
  <key>ProgramArguments</key>
  <array><string>REPO/p2b</string><string>serve</string></array>
  <key>WorkingDirectory</key><string>REPO</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/paper2brain.log</string>
  <key>StandardErrorPath</key><string>/tmp/paper2brain.log</string>
</dict>
</plist>
